(set-option :produce-proofs true)
(set-logic QF_AUFBV)
(declare-sort U 0)
(declare-const index U)
(declare-const value U)
(declare-const a (Array U U))
(declare-const b (Array U U))
(declare-fun observe ((Array U U)) (_ BitVec 2))
(assert (= a b))
(assert (distinct (observe a) (observe b)))
(assert (distinct (select (store a index value) index) value))
(check-sat)
(get-proof)
