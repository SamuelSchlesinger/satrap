(set-option :produce-proofs true)
(set-logic QF_BOOL)
(define-sort Flag () Bool)
(declare-const a Flag)
(declare-const b Bool)
(define-const implication Bool (=> a b))
(define-fun same () Bool (= (xor a b) (xor b a)))
(assert same)
(assert a)
(assert (not b))
(assert
  (let ((x implication)
        (y (ite a b false)))
    (or (not same) (and x y))))
(check-sat)
(get-proof)
