(set-option :produce-proofs true)
(set-option :global-declarations true)
(set-logic QF_BOOL)
(define-sort Flag () Bool)
(declare-const p Flag)
(declare-const q Flag)
(define-const different Bool (xor p q))
(assert p)
(reset-assertions)
(push 1)
(declare-const local Bool)
(assert local)
(pop 1)
(assert local)
(assert different)
(assert (= p q))
(check-sat)
(get-proof)
