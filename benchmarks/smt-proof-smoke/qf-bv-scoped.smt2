(set-option :produce-proofs true)
(set-option :global-declarations true)
(set-logic QF_BV)
(define-sort Word () (_ BitVec 3))
(declare-const x Word)
(define-const next Word (bvadd x #b001))
(push 1)
(declare-const y Word)
(assert (= y next))
(check-sat)
(pop 1)
(reset-assertions)
(assert (! (= x #b010) :named base))
(assert
  (= y
     (let ((z next))
       (bvadd z #b001))))
(assert (= ((_ rotate_left 1) y) #b000))
(check-sat)
(get-proof)
