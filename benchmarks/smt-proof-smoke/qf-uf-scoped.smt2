(set-option :produce-proofs true)
(set-option :global-declarations true)
(set-logic QF_UF)
(declare-sort U 0)
(define-sort Element () U)
(declare-const a Element)
(declare-fun f (Element) Element)
(push 1)
(declare-const b Element)
(assert (= b (f a)))
(check-sat)
(pop 1)
(reset-assertions)
(assert (! (= a b) :named same))
(assert (distinct (f a) (f b)))
(check-sat)
(get-proof)
