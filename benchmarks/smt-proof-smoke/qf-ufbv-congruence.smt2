(set-option :produce-proofs true)
(set-logic QF_UFBV)
(declare-sort U 0)
(declare-const a U)
(declare-const b U)
(declare-const x (_ BitVec 4))
(declare-const y (_ BitVec 4))
(declare-const condition Bool)
(declare-fun word (U (_ BitVec 4) Bool) (_ BitVec 4))
(declare-fun element ((_ BitVec 4)) U)
(declare-fun predicate (U) Bool)
(assert (= a b))
(assert (= x y))
(assert condition)
(assert (= (element x) (element y)))
(assert (= (predicate a) (predicate b)))
(assert
  (distinct
    (word a x condition)
    (word b y true)))
(check-sat)
(get-proof)
