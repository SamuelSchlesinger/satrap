(set-option :produce-models true)
(set-logic QF_UF)
(declare-sort U 0)
(declare-const a U)
(declare-fun f (U) U)
(assert (distinct (f a) a))
(check-sat)
(get-value (a (f a)))
(get-value ((as @uc!0!0 U) (as @uc!0!1 U) (f (as @uc!0!0 U))
  (= (f (as @uc!0!0 U)) (as @uc!0!1 U))))
(assert (= a (as @uc!0!0 U)))
(get-value ((as @uc!0!01 U)))
(get-value (a (f a)))
(exit)
