(set-option :produce-assignments true)
(set-option :produce-unsat-cores true)
(set-logic QF_BOOL)
(declare-const p Bool)
(declare-const q Bool)
(push 1)
(assert (! (or (! p :named inner) q) :named outer))
(check-sat)
(get-assignment)
(assert (not p))
(assert (not q))
(check-sat)
(get-unsat-core)
(pop 1)
(assert (and later (! p :named later)))
(assert (! p :named later))
(check-sat)
(get-assignment)
(exit)
